<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#10140F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="fastagg узел"
        android:textColor="#C6F27A"
        android:textSize="24sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вставьте ссылку с координатора или отсканируйте QR. Интернет не нужен: бинарник уже в приложении."
        android:textColor="#9AAB96"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="fastagg://192.168.1.10:8080?code=...&amp;fp=..."
        android:textColor="#E7F0E2"
        android:textColorHint="#6E7C6A"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <Button
        android:id="@+id/scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сканировать QR" />

    <Button
        android:id="@+id/pair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сопрячь и запустить" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textColor="#E7F0E2"
        android:text="Узел не запущен" />
</LinearLayout>
