# Скопируйте в .env проекта RAG-5060 рядом с его собственными переменными.
# Порт 11435 — совместимый порт координатора fastagg на Windows-хосте.
# Пустой FASTAGG_TOKEN означает, что координатор запущен без --api-token.

OLLAMA_HOST=http://host.docker.internal:11435
OLLAMA_MODEL=qwen3:8b
EMBEDDING_URL=http://host.docker.internal:11435/v1/embeddings
RERANK_URL=http://host.docker.internal:11435/v1/rerank
FASTAGG_TOKEN=
